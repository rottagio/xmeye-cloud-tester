<Window x:Class="XMEyeCloudTester.CameraSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configurações da câmera" Width="1180" Height="760"
        MinWidth="980" MinHeight="650" WindowStartupLocation="CenterOwner"
        Background="#071522" Foreground="#F3F7FC" Icon="Assets/AppIcon.ico">
  <Window.Resources>
    <SolidColorBrush x:Key="Panel" Color="#0D2033"/>
    <SolidColorBrush x:Key="PanelAlt" Color="#12283E"/>
    <SolidColorBrush x:Key="Border" Color="#203C57"/>
    <SolidColorBrush x:Key="Muted" Color="#93A9C1"/>
    <SolidColorBrush x:Key="Accent" Color="#35C6D0"/>
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="#EEF6FF"/>
      <Setter Property="Background" Value="#142C45"/>
      <Setter Property="BorderBrush" Value="#385675"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="16,9"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontSize" Value="14"/>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#1B3A59"/></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Height" Value="54"/>
      <Setter Property="Margin" Value="12,4"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="FontSize" Value="15"/>
    </Style>
    <Style x:Key="ActiveNavButton" TargetType="Button" BasedOn="{StaticResource NavButton}">
      <Setter Property="Background" Value="#173A5D"/>
      <Setter Property="BorderBrush" Value="#2A5275"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource Panel}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="18"/>
      <Setter Property="Margin" Value="0,0,14,14"/>
    </Style>
    <Style x:Key="Field" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource PanelAlt}"/>
      <Setter Property="BorderBrush" Value="#27445F"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="7"/>
      <Setter Property="Padding" Value="14,10"/>
      <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="FontSize" Value="16"/>
      <Setter Property="Padding" Value="0,4"/>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Background" Value="#142C45"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderBrush" Value="#385675"/>
      <Setter Property="Padding" Value="9,6"/>
      <Setter Property="FontSize" Value="15"/>
    </Style>
    <Style x:Key="Switch" TargetType="CheckBox">
      <Setter Property="Width" Value="58"/>
      <Setter Property="Height" Value="30"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Grid>
              <Border x:Name="Track" Background="#405268" CornerRadius="15"/>
              <Ellipse x:Name="Thumb" Width="24" Height="24" Fill="White"
                       HorizontalAlignment="Left" Margin="3,0,0,0"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Track" Property="Background" Value="{StaticResource Accent}"/>
                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                <Setter TargetName="Thumb" Property="Margin" Value="0,0,3,0"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="68"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="78"/>
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="240"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <Border Grid.Row="0" Grid.ColumnSpan="2" Background="#081827" BorderBrush="#1B344D" BorderThickness="0,0,0,1">
      <Grid Margin="20,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Button Content="←" FontSize="25" Background="Transparent" BorderThickness="0" Padding="8" Click="Close_Click"/>
        <TextBlock x:Name="WindowTitleText" Grid.Column="1" FontSize="18" VerticalAlignment="Center" Margin="14,0,18,0"/>
        <Border Grid.Column="2" BorderBrush="#29425C" BorderThickness="1,0,0,0" Padding="18,0,0,0">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Ellipse Width="10" Height="10" Fill="#4ED69B" Margin="0,0,9,0"/>
            <TextBlock Text="Câmera conectada" Foreground="#AFC1D4" VerticalAlignment="Center"/>
          </StackPanel>
        </Border>
        <Button x:Name="ReloadButton" Grid.Column="4" Content="↻  Consultar novamente" Click="Reload_Click"/>
      </Grid>
    </Border>

    <Border Grid.Row="1" Grid.Column="0" Background="#091B2B" BorderBrush="#1B344D" BorderThickness="0,0,1,0">
      <StackPanel Margin="0,12">
        <Button Style="{StaticResource ActiveNavButton}" Content="⚙   Básicas"/>
        <Button Style="{StaticResource NavButton}" Content="◉   Gravação" IsEnabled="False" ToolTip="Aguardando mapeamento nativo validado"/>
        <Button Style="{StaticResource NavButton}" Content="☼   Imagem e luz" IsEnabled="False" ToolTip="Aguardando mapeamento nativo validado"/>
        <Button Style="{StaticResource NavButton}" Content="♧   Alarme inteligente" IsEnabled="False" ToolTip="Aguardando mapeamento nativo validado"/>
        <Button Style="{StaticResource NavButton}" Content="⌾   Rastreamento" IsEnabled="False" ToolTip="Aguardando mapeamento nativo validado"/>
        <Button Style="{StaticResource NavButton}" Content="▣   Armazenamento" IsEnabled="False" ToolTip="Aguardando mapeamento nativo validado"/>
        <Button Style="{StaticResource NavButton}" Content="◎   Rede" IsEnabled="False" ToolTip="Aguardando mapeamento nativo validado"/>
        <Button Style="{StaticResource NavButton}" Content="ⓘ   Sobre" IsEnabled="False" ToolTip="Aguardando leitura tipada validada"/>
      </StackPanel>
    </Border>

    <ScrollViewer Grid.Row="1" Grid.Column="1" VerticalScrollBarVisibility="Auto">
      <Grid Margin="26,22,12,18">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
          <TextBlock Text="Configuração básica" FontSize="27" FontWeight="SemiBold"/>
          <StackPanel Orientation="Horizontal" Margin="0,8,0,18">
            <TextBlock x:Name="LoadStateIcon" Text="◌" Foreground="#F2B94B" FontSize="18" Margin="0,0,8,0"/>
            <TextBlock x:Name="LoadStateText" Text="Consultando a câmera…" Foreground="#87B9E8" FontSize="14" VerticalAlignment="Center"/>
          </StackPanel>
        </StackPanel>

        <Grid Grid.Row="1">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0">
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="Identificação" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,13"/>
                <Border Style="{StaticResource Field}">
                  <StackPanel>
                    <TextBlock Text="Nome do dispositivo" Foreground="{StaticResource Muted}"/>
                    <TextBox x:Name="MachineNameBox" MaxLength="63" TextChanged="EditableControl_Changed"/>
                  </StackPanel>
                </Border>
                <Border Style="{StaticResource Field}">
                  <StackPanel>
                    <TextBlock Text="Idioma" Foreground="{StaticResource Muted}"/>
                    <TextBlock x:Name="LanguageText" FontSize="16" Margin="0,5,0,3"/>
                  </StackPanel>
                </Border>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="Imagem e áudio" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,13"/>
                <Border Style="{StaticResource Field}">
                  <StackPanel>
                    <Grid><TextBlock Text="Sensibilidade dia/noite"/><TextBlock x:Name="SensitivityValue" HorizontalAlignment="Right" FontWeight="SemiBold"/></Grid>
                    <Slider x:Name="SensitivitySlider" Minimum="0" Maximum="10" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,10,0,0" ValueChanged="EditableControl_Changed"/>
                    <Grid TextElement.Foreground="{StaticResource Muted}"><TextBlock Text="0"/><TextBlock x:Name="SensitivityMaximumText" Text="10" HorizontalAlignment="Right"/></Grid>
                  </StackPanel>
                </Border>
                <Border Style="{StaticResource Field}">
                  <StackPanel>
                    <Grid><TextBlock Text="Volume do alto-falante"/><TextBlock x:Name="VolumeValue" HorizontalAlignment="Right" FontWeight="SemiBold"/></Grid>
                    <Slider x:Name="VolumeSlider" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,10,0,0" ValueChanged="EditableControl_Changed"/>
                    <Grid TextElement.Foreground="{StaticResource Muted}"><TextBlock Text="0"/><TextBlock Text="100" HorizontalAlignment="Right"/></Grid>
                    <TextBlock x:Name="AudioModeText" Foreground="{StaticResource Muted}" Margin="0,5,0,0"/>
                  </StackPanel>
                </Border>
                <Border Style="{StaticResource Field}">
                  <StackPanel>
                    <TextBlock Text="Velocidade de rotação" Foreground="{StaticResource Muted}"/>
                    <ComboBox x:Name="RotationSpeedBox" Margin="0,7,0,0" SelectionChanged="EditableControl_Changed">
                      <ComboBoxItem Content="Lenta" Tag="1"/>
                      <ComboBoxItem Content="Média" Tag="3"/>
                      <ComboBoxItem Content="Rápida" Tag="5"/>
                    </ComboBox>
                    <TextBlock Text="Aplicada aos controles PTZ deste aplicativo." Foreground="{StaticResource Muted}" Margin="0,5,0,0"/>
                  </StackPanel>
                </Border>
              </StackPanel>
            </Border>
          </StackPanel>

          <StackPanel Grid.Column="1">
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="Orientação da imagem" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,13"/>
                <Border Style="{StaticResource Field}">
                  <Grid><TextBlock Text="Espelhar horizontal" VerticalAlignment="Center"/><CheckBox x:Name="MirrorSwitch" Style="{StaticResource Switch}" HorizontalAlignment="Right" Checked="EditableControl_Changed" Unchecked="EditableControl_Changed"/></Grid>
                </Border>
                <Border Style="{StaticResource Field}">
                  <Grid><TextBlock Text="Inverter vertical" VerticalAlignment="Center"/><CheckBox x:Name="FlipSwitch" Style="{StaticResource Switch}" HorizontalAlignment="Right" Checked="EditableControl_Changed" Unchecked="EditableControl_Changed"/></Grid>
                </Border>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="Data e hora" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,13"/>
                <Border Style="{StaticResource Field}">
                  <StackPanel>
                    <TextBlock Text="Fuso horário" Foreground="{StaticResource Muted}"/>
                    <ComboBox x:Name="TimeZoneBox" Margin="0,7,0,0" SelectionChanged="EditableControl_Changed"/>
                  </StackPanel>
                </Border>
                <Border Style="{StaticResource Field}">
                  <StackPanel>
                    <TextBlock Text="Hora da câmera" Foreground="{StaticResource Muted}"/>
                    <TextBlock x:Name="CameraTimeText" FontSize="16" Margin="0,5,0,3"/>
                  </StackPanel>
                </Border>
                <Button x:Name="SynchronizeButton" Content="◷  Sincronizar com o computador" Click="Synchronize_Click"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </Grid>
      </Grid>
    </ScrollViewer>

    <Border Grid.Row="2" Grid.ColumnSpan="2" Background="#091B2B" BorderBrush="#24415C" BorderThickness="1,1,1,0" Margin="6,0,6,6" CornerRadius="8">
      <Grid Margin="20,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock x:Name="PendingIcon" Text="✓" Foreground="{StaticResource Accent}" FontSize="24" Margin="0,0,12,0"/>
          <TextBlock x:Name="PendingText" Text="Nenhuma alteração pendente" Foreground="#B4C3D3" VerticalAlignment="Center"/>
        </StackPanel>
        <Button x:Name="DiscardButton" Grid.Column="1" Content="Descartar" Width="150" Margin="0,0,12,0" Click="Discard_Click" IsEnabled="False"/>
        <Button x:Name="SaveButton" Grid.Column="2" Content="Salvar alterações" Width="175" Click="Save_Click" IsEnabled="False"/>
      </Grid>
    </Border>
  </Grid>
</Window>
