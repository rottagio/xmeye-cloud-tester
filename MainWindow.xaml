<Window x:Class="XMEyeCloudTester.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wfi="clr-namespace:System.Windows.Forms.Integration;assembly=WindowsFormsIntegration"
        Title="XMEye Cloud — Conta HTTPS" Width="1120" Height="760"
        MinWidth="960" MinHeight="680"
        WindowStartupLocation="CenterScreen" Background="#0B1220">
  <Grid Margin="22">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="350"/>
      <ColumnDefinition Width="18"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="*"/>
      <RowDefinition Height="205"/>
    </Grid.RowDefinitions>

    <Border Grid.RowSpan="2" Background="#111C2E" CornerRadius="14" Padding="20">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <TextBlock Text="Sua conta XMEye/iCSee" Foreground="White" FontSize="23" FontWeight="SemiBold"/>
          <TextBlock Text="Entre uma vez e escolha uma das câmeras vinculadas."
                     Foreground="#91A4C3" Margin="0,5,0,22" TextWrapping="Wrap"/>

          <TextBlock Text="E-mail ou usuário da conta" Foreground="#CAD6E8"/>
          <TextBox x:Name="AccountBox" Margin="0,6,0,14" Padding="10" FontSize="15"/>
          <TextBlock Text="Senha da conta" Foreground="#CAD6E8"/>
          <PasswordBox x:Name="AccountPasswordBox" Margin="0,6,0,14" Padding="10" FontSize="15"/>

          <TextBlock Text="Código de verificação" Foreground="#CAD6E8"/>
          <Grid Margin="0,6,0,14">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="145"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Height="58" Background="White" CornerRadius="4" ClipToBounds="True">
              <Image x:Name="CaptchaImage" Stretch="Uniform"/>
            </Border>
            <Grid Grid.Column="1" Margin="10,0,0,0">
              <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <TextBox x:Name="CaptchaBox" MaxLength="4" Padding="9" FontSize="17"
                       VerticalContentAlignment="Center"/>
              <Button x:Name="RefreshCaptchaButton" Grid.Row="1" Content="Trocar imagem"
                      Margin="0,5,0,0" Padding="7,2" IsEnabled="False"
                      Click="RefreshCaptcha_Click"/>
            </Grid>
          </Grid>
          <Button x:Name="AccountLoginButton" Content="ENTRAR E CARREGAR CÂMERAS" Height="44"
                  Background="#2D6CDF" Foreground="White" FontWeight="SemiBold"
                  BorderThickness="0" IsEnabled="False" Click="AccountLogin_Click"/>

          <Separator Margin="0,20,0,18" Background="#30415B"/>
          <TextBlock Text="Câmera" Foreground="#CAD6E8"/>
          <ComboBox x:Name="DeviceBox" Margin="0,6,0,14" Padding="8" IsEnabled="False"
                    SelectionChanged="DeviceBox_SelectionChanged"/>
          <TextBlock Text="Canal" Foreground="#CAD6E8"/>
          <ComboBox x:Name="ChannelBox" SelectedIndex="0" Margin="0,6,0,14" Padding="8">
            <ComboBoxItem Content="0"/><ComboBoxItem Content="1"/>
            <ComboBoxItem Content="2"/><ComboBoxItem Content="3"/>
          </ComboBox>
          <CheckBox x:Name="SubstreamBox" Content="Usar fluxo leve (SD)" IsChecked="True"
                    Foreground="#CAD6E8" Margin="0,0,0,20"/>

          <Button x:Name="OpenCameraButton" Content="ABRIR CÂMERA SELECIONADA" Height="44"
                  IsEnabled="False" Background="#1E9B68" Foreground="White"
                  FontWeight="SemiBold" BorderThickness="0" Click="OpenCamera_Click"/>
          <Button x:Name="DisconnectButton" Content="DESCONECTAR VÍDEO" Height="38"
                  Margin="0,10,0,0" IsEnabled="False" Click="Disconnect_Click"/>
          <Button x:Name="ForgetAccountButton" Content="SAIR E LIMPAR DADOS DA CONTA" Height="38"
                  Margin="0,10,0,0" IsEnabled="False" Click="ForgetAccount_Click"/>

          <TextBlock Text="O código acima é exigido pelo serviço oficial atual. A senha da conta e as credenciais internas das câmeras ficam somente na memória. Nada disso é salvo nem incluído no diagnóstico."
                     Foreground="#7890B2" TextWrapping="Wrap" Margin="0,20,0,0" FontSize="12"/>
        </StackPanel>
      </ScrollViewer>
    </Border>

    <Border Grid.Column="2" Background="Black" CornerRadius="14" ClipToBounds="True">
      <Grid>
        <wfi:WindowsFormsHost x:Name="VideoHost"/>
        <TextBlock x:Name="VideoPlaceholder" Text="Selecione uma câmera para abrir o vídeo remoto"
                   Foreground="#7D8DA5" FontSize="20" TextWrapping="Wrap" TextAlignment="Center"
                   MaxWidth="460" HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Grid>
    </Border>

    <Border Grid.Column="2" Grid.Row="1" Background="#111C2E" CornerRadius="14"
            Margin="0,16,0,0" Padding="14">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
        <DockPanel>
          <TextBlock Text="DIAGNÓSTICO SEM CREDENCIAIS" Foreground="#91A4C3" FontWeight="SemiBold"/>
          <Button Content="Copiar" DockPanel.Dock="Right" Padding="10,3" Click="CopyLog_Click"/>
        </DockPanel>
        <TextBox x:Name="LogBox" Grid.Row="1" Margin="0,8,0,0" Background="Transparent"
                 Foreground="#C9D7EB" BorderThickness="0" IsReadOnly="True" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto" FontFamily="Consolas"/>
      </Grid>
    </Border>
  </Grid>
</Window>
