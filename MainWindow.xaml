<Window x:Class="XMEyeCloudTester.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wfi="clr-namespace:System.Windows.Forms.Integration;assembly=WindowsFormsIntegration"
        Title="iCSee/XMEye Monitor" Icon="Assets/AppIcon.ico" Width="1440" Height="900"
        MinWidth="920" MinHeight="650" WindowStartupLocation="CenterScreen"
        Background="#07111E">
  <Window.Resources>
    <SolidColorBrush x:Key="Panel" Color="#0D1928"/>
    <SolidColorBrush x:Key="PanelAlt" Color="#111F31"/>
    <SolidColorBrush x:Key="Text" Color="#F3F7FC"/>
    <SolidColorBrush x:Key="Muted" Color="#8EA2BC"/>
    <SolidColorBrush x:Key="Accent" Color="#1677FF"/>
    <Style TargetType="Button">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Padding" Value="14,9"/>
      <Setter Property="Background" Value="#172A42"/>
      <Setter Property="Foreground" Value="#EAF1FA"/>
      <Setter Property="BorderBrush" Value="#34506F"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="5" SnapsToDevicePixels="True">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                Margin="{TemplateBinding Padding}"
                                TextElement.Foreground="{TemplateBinding Foreground}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ButtonBorder" Property="Background" Value="#21436A"/>
                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#3D8BFF"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="ButtonBorder" Property="Background" Value="#1265D4"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="ButtonBorder" Property="Background" Value="#101C2B"/>
                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#24364B"/>
                <Setter Property="Foreground" Value="#657991"/>
                <Setter Property="Opacity" Value="0.82"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Height" Value="52"/>
      <Setter Property="Margin" Value="14,5"/>
      <Setter Property="Padding" Value="18,0"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Background" Value="#0E1C2C"/>
      <Setter Property="Foreground" Value="#DCE8F7"/>
      <Setter Property="FontSize" Value="15"/>
    </Style>
    <Style x:Key="ToolButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Margin" Value="4"/>
      <Setter Property="Padding" Value="12,8"/>
      <Setter Property="MinWidth" Value="42"/>
      <Setter Property="MinHeight" Value="36"/>
      <Setter Property="Background" Value="#102238"/>
      <Setter Property="BorderBrush" Value="#294765"/>
    </Style>
    <Style x:Key="QualityButton" TargetType="Button" BasedOn="{StaticResource ToolButton}">
      <Setter Property="MinWidth" Value="48"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="PtzDirectionButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Foreground" Value="#DCE5EF"/>
      <Setter Property="FontFamily" Value="Segoe UI Symbol"/>
      <Setter Property="FontSize" Value="20"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Margin" Value="0"/>
      <Setter Property="MinWidth" Value="0"/>
      <Setter Property="MinHeight" Value="0"/>
    </Style>
    <Style x:Key="PtzPresetButton" TargetType="Button" BasedOn="{StaticResource ToolButton}">
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Margin" Value="2"/>
      <Setter Property="MinWidth" Value="0"/>
      <Setter Property="MinHeight" Value="26"/>
      <Setter Property="Height" Value="26"/>
      <Setter Property="FontSize" Value="11"/>
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="#1677FF"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="#F8FAFD"/>
      <Setter Property="Foreground" Value="#152235"/>
      <Setter Property="BorderBrush" Value="#334963"/>
      <Setter Property="Padding" Value="10"/>
      <Setter Property="FontSize" Value="14"/>
    </Style>
    <Style TargetType="PasswordBox">
      <Setter Property="Background" Value="#F8FAFD"/>
      <Setter Property="Foreground" Value="#152235"/>
      <Setter Property="BorderBrush" Value="#334963"/>
      <Setter Property="Padding" Value="10"/>
      <Setter Property="FontSize" Value="14"/>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Padding" Value="8"/>
      <Setter Property="FontSize" Value="14"/>
    </Style>
  </Window.Resources>

  <Grid x:Name="RootGrid">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="230"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <Border x:Name="SidebarBorder" Background="#081421" BorderBrush="#1A2B3D" BorderThickness="0,0,1,0">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="112"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="0"/>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Margin="22,25,12,20" VerticalAlignment="Center">
          <Border Width="42" Height="42" CornerRadius="10" Background="#0E3E78">
            <TextBlock Text="◉" Foreground="#36A3FF" FontSize="25" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="iCSee/XMEye" Foreground="White" FontWeight="SemiBold" FontSize="16"/>
            <TextBlock Text="Monitor" Foreground="#7890AA" FontSize="11"/>
            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
              <TextBlock x:Name="VersionText" Foreground="#D4B28A" FontSize="10" VerticalAlignment="Center"/>
              <Button Content="↻" Style="{StaticResource ToolButton}" Width="25" Height="23" MinWidth="0" MinHeight="0"
                      Padding="0" Margin="7,0,0,0" FontSize="14" ToolTip="Verificar atualização" Click="CheckUpdate_Click"/>
            </StackPanel>
          </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,8,0,4">
          <Button x:Name="LiveNavButton" Style="{StaticResource NavButton}" Tag="Live" Click="Navigate_Click"
                  Background="#173657" Foreground="White" BorderBrush="#1677FF" BorderThickness="3,0,0,0" Content="▣   Ao vivo"/>
          <Button x:Name="CamerasNavButton" Style="{StaticResource NavButton}" Foreground="#DCE8F7" Tag="Cameras" Click="Navigate_Click" Content="▤   Câmeras"/>
          <Button x:Name="RecordingsNavButton" Style="{StaticResource NavButton}" Foreground="#DCE8F7" Tag="Recordings" Click="Navigate_Click" Content="▶   Gravações"/>
          <Button x:Name="SettingsNavButton" Style="{StaticResource NavButton}" Foreground="#DCE8F7" Tag="Settings" Click="Navigate_Click" Content="⚙   Configurações"/>
        </StackPanel>

        <Border x:Name="PtzSidePanel" Grid.Row="2" Margin="16,8" VerticalAlignment="Bottom"
                Background="#0D1A29" BorderBrush="#29415D" BorderThickness="1" CornerRadius="7">
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="11">
            <DockPanel Margin="0,0,0,5">
              <TextBlock Text="CONTROLE PTZ" Foreground="#DDE9F7" FontWeight="SemiBold" FontSize="11"/>
              <TextBlock Text="⌃" Foreground="#8EA2BC" HorizontalAlignment="Right"/>
            </DockPanel>
            <TextBlock x:Name="PtzCameraText" Text="Selecione uma câmera" Foreground="#8EA2BC"
                       TextTrimming="CharacterEllipsis" FontSize="10" Margin="0,0,0,5"/>
            <Grid Width="128" Height="118" HorizontalAlignment="Center">
              <Ellipse Stroke="#29415D" StrokeThickness="1"/>
              <Ellipse Width="42" Height="42" Stroke="#29415D" StrokeThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              <Button Content="⌃" Tag="0" Style="{StaticResource PtzDirectionButton}" Width="38" Height="30"
                      HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,7,0,0"
                      PreviewMouseLeftButtonDown="PtzCommand_Down" PreviewMouseLeftButtonUp="PtzCommand_Up" MouseLeave="PtzCommand_Leave"/>
              <Button Content="⌄" Tag="1" Style="{StaticResource PtzDirectionButton}" Width="38" Height="30"
                      HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,7"
                      PreviewMouseLeftButtonDown="PtzCommand_Down" PreviewMouseLeftButtonUp="PtzCommand_Up" MouseLeave="PtzCommand_Leave"/>
              <Button Content="‹" Tag="2" Style="{StaticResource PtzDirectionButton}" Width="30" Height="38"
                      HorizontalAlignment="Left" VerticalAlignment="Center" Margin="7,0,0,0"
                      PreviewMouseLeftButtonDown="PtzCommand_Down" PreviewMouseLeftButtonUp="PtzCommand_Up" MouseLeave="PtzCommand_Leave"/>
              <Button Content="›" Tag="3" Style="{StaticResource PtzDirectionButton}" Width="30" Height="38"
                      HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,7,0"
                      PreviewMouseLeftButtonDown="PtzCommand_Down" PreviewMouseLeftButtonUp="PtzCommand_Up" MouseLeave="PtzCommand_Leave"/>
            </Grid>
            <UniformGrid Columns="3" Margin="0,5,0,7">
              <Button Content="−" Tag="8" Style="{StaticResource ToolButton}" ToolTip="Diminuir zoom"
                      PreviewMouseLeftButtonDown="PtzCommand_Down" PreviewMouseLeftButtonUp="PtzCommand_Up" MouseLeave="PtzCommand_Leave"/>
              <TextBlock Text="Zoom" Foreground="#DDE9F7" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              <Button Content="+" Tag="9" Style="{StaticResource ToolButton}" ToolTip="Aumentar zoom"
                      PreviewMouseLeftButtonDown="PtzCommand_Down" PreviewMouseLeftButtonUp="PtzCommand_Up" MouseLeave="PtzCommand_Leave"/>
            </UniformGrid>
            <ComboBox x:Name="PtzPresetBox" SelectedIndex="0" Visibility="Collapsed">
              <ComboBoxItem Content="Posição 1" Tag="1"/><ComboBoxItem Content="Posição 2" Tag="2"/>
              <ComboBoxItem Content="Posição 3" Tag="3"/><ComboBoxItem Content="Posição 4" Tag="4"/>
              <ComboBoxItem Content="Posição 5" Tag="5"/><ComboBoxItem Content="Posição 6" Tag="6"/>
            </ComboBox>
            <UniformGrid Columns="6" Margin="0,0,0,7">
              <Button Content="1" Tag="1" Style="{StaticResource PtzPresetButton}" Click="PtzPresetQuick_Click"
                      PreviewMouseRightButtonUp="PtzPresetQuick_RightClick" ToolTip="Clique: ir · Botão direito: salvar"/>
              <Button Content="2" Tag="2" Style="{StaticResource PtzPresetButton}" Click="PtzPresetQuick_Click"
                      PreviewMouseRightButtonUp="PtzPresetQuick_RightClick" ToolTip="Clique: ir · Botão direito: salvar"/>
              <Button Content="3" Tag="3" Style="{StaticResource PtzPresetButton}" Click="PtzPresetQuick_Click"
                      PreviewMouseRightButtonUp="PtzPresetQuick_RightClick" ToolTip="Clique: ir · Botão direito: salvar"/>
              <Button Content="4" Tag="4" Style="{StaticResource PtzPresetButton}" Click="PtzPresetQuick_Click"
                      PreviewMouseRightButtonUp="PtzPresetQuick_RightClick" ToolTip="Clique: ir · Botão direito: salvar"/>
              <Button Content="5" Tag="5" Style="{StaticResource PtzPresetButton}" Click="PtzPresetQuick_Click"
                      PreviewMouseRightButtonUp="PtzPresetQuick_RightClick" ToolTip="Clique: ir · Botão direito: salvar"/>
              <Button Content="6" Tag="6" Style="{StaticResource PtzPresetButton}" Click="PtzPresetQuick_Click"
                      PreviewMouseRightButtonUp="PtzPresetQuick_RightClick" ToolTip="Clique: ir · Botão direito: salvar"/>
            </UniformGrid>
            <UniformGrid Columns="2">
              <Button x:Name="AudioButton" Style="{StaticResource ToolButton}" Content="🔊 Ouvir" IsEnabled="False" Click="ToggleAudio_Click"/>
              <Button x:Name="TalkButton" Style="{StaticResource ToolButton}" Content="🎙 Falar" IsEnabled="False" Click="ToggleTalk_Click"/>
              <Button x:Name="CaptureButton" Style="{StaticResource ToolButton}" Content="📷 Foto" IsEnabled="False" Click="CaptureSelected_Click"/>
              <Button x:Name="RecordButton" Style="{StaticResource ToolButton}" Content="⏺ Gravar" IsEnabled="False" Click="ToggleRecord_Click"/>
            </UniformGrid>
          </StackPanel>
          </ScrollViewer>
        </Border>

      </Grid>
    </Border>

    <Grid Grid.Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="70"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <Border x:Name="HeaderBorder" Background="#091522" BorderBrush="#1B2C40" BorderThickness="0,0,0,1">
        <Grid Margin="24,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock x:Name="PageTitleText" Text="Monitoramento" Foreground="{StaticResource Text}" FontSize="23" FontWeight="SemiBold"/>
            <TextBlock x:Name="OnlineStatusText" Text="●  Aguardando câmeras" Foreground="#37D26D" FontSize="14" Margin="28,5,0,0"/>
          </StackPanel>
          <StackPanel x:Name="LiveHeaderControls" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="Layout:" Foreground="{StaticResource Muted}" Margin="0,0,10,0" VerticalAlignment="Center"/>
            <UniformGrid x:Name="GridButtonsPanel" Columns="4">
              <Button Content="▣ 1" Tag="1" Margin="3" IsEnabled="False" Click="GridLayout_Click"/>
              <Button Content="▦ 4" Tag="4" Margin="3" IsEnabled="False" Click="GridLayout_Click"/>
              <Button Content="▦ 9" Tag="9" Margin="3" IsEnabled="False" Click="GridLayout_Click" Background="#1677FF"/>
              <Button Content="▦ 16" Tag="16" Margin="3" IsEnabled="False" Click="GridLayout_Click"/>
            </UniformGrid>
          </StackPanel>
        </Grid>
      </Border>

      <Grid Grid.Row="1">
        <Grid x:Name="LiveView" Margin="16">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="420"/>
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <Border Background="Black" BorderBrush="#263A50" BorderThickness="1" CornerRadius="6" ClipToBounds="True">
            <Grid>
              <wfi:WindowsFormsHost x:Name="VideoHost"/>
              <StackPanel x:Name="VideoPlaceholder" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="▣" Foreground="#29415D" FontSize="54" HorizontalAlignment="Center"/>
                <TextBlock Text="Entre em uma conta ou adicione uma câmera" Foreground="#70849D" FontSize="18" Margin="0,8,0,0"/>
              </StackPanel>
            </Grid>
          </Border>
          <Border Grid.Row="1" Background="#0D1A29" BorderBrush="#1B2D42" BorderThickness="1,0,0,0" Padding="10,7">
            <DockPanel LastChildFill="True">
              <TextBlock x:Name="SelectedCameraText" DockPanel.Dock="Top" Text="Nenhuma câmera selecionada"
                         Foreground="#8EA2BC" Margin="5,0,5,4" TextTrimming="CharacterEllipsis"/>
              <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <WrapPanel>
                  <Border BorderBrush="#29415D" BorderThickness="0,0,1,0" Margin="0,0,5,0">
                    <WrapPanel>
                      <Button x:Name="SeparateWindowButton" Style="{StaticResource ToolButton}" Content="▣ Janela" IsEnabled="False" Click="OpenSeparateWindow_Click"/>
                      <Button Style="{StaticResource ToolButton}" Content="⛶ Tela cheia" Click="ToggleFullscreen_Click"/>
                    </WrapPanel>
                  </Border>
                  <Border BorderBrush="#29415D" BorderThickness="0,0,1,0" Margin="0,0,5,0">
                    <WrapPanel>
                      <Button x:Name="ReconnectFailedButton" Style="{StaticResource ToolButton}"
                              Content="↻ Reconectar falhas" Click="ReconnectAll_Click"
                              ToolTip="Tenta somente câmeras offline, uma por vez, respeitando os intervalos de proteção"/>
                      <Button x:Name="DisconnectButton" Style="{StaticResource ToolButton}" Content="Desconectar" IsEnabled="False" Click="Disconnect_Click"/>
                    </WrapPanel>
                  </Border>
                  <Button Content="↻ Ordem das câmeras" Style="{StaticResource ToolButton}"
                          ToolTip="Reaplicar a ordem definida na tela Câmeras" Click="ResetLiveOrder_Click"/>
                  <WrapPanel>
                    <Button x:Name="SdButton" Style="{StaticResource QualityButton}" Content="SD" Tag="SD" Click="StreamQuality_Click"/>
                    <Button x:Name="HdButton" Style="{StaticResource QualityButton}" Content="HD" Tag="HD" Click="StreamQuality_Click"/>
                    <CheckBox x:Name="SubstreamBox" Visibility="Collapsed" IsChecked="True" Click="DefaultStreamChanged_Click"/>
                  </WrapPanel>
                </WrapPanel>
              </ScrollViewer>
            </DockPanel>
          </Border>

        </Grid>

        <Grid x:Name="CamerasView" Visibility="Collapsed" Margin="22">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="430"/>
            <ColumnDefinition Width="18"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Border Background="{StaticResource Panel}" CornerRadius="10" Padding="20">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel>
                <TextBlock Text="Adicionar câmeras" Foreground="White" FontSize="20" FontWeight="SemiBold"/>
                <TextBlock Text="Use sua conta oficial ou cadastre dispositivos individualmente." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,18"/>
                <UniformGrid Columns="2" Margin="0,0,0,18">
                  <Button Content="Conta iCSee" Background="#1677FF" Margin="0,0,5,5" Click="UseAccountLogin_Click"/>
                  <Button Content="Ler QR" ToolTip="Gerar o QR oficial da conta" Margin="5,0,0,5" Click="ReadAccountQr_Click"/>
                  <Button Content="Cloud ID" ToolTip="Adicionar um dispositivo nesta sessão" Margin="0,5,5,0" Click="AddCloudId_Click"/>
                  <Button Content="IP / Rede" ToolTip="Adicionar uma câmera acessível nesta rede" Margin="5,5,0,0" Click="AddNetworkDevice_Click"/>
                  <Button Content="QR da câmera" ToolTip="Colar ou digitar o conteúdo do QR do dispositivo" Margin="0,10,5,0" Click="AddDeviceQr_Click"/>
                </UniformGrid>

                <Border Background="White" CornerRadius="8" Padding="10" Width="235" Height="235" HorizontalAlignment="Center">
                  <Grid>
                    <Image x:Name="QrImage" Stretch="Uniform"/>
                    <TextBlock x:Name="QrStatusText" Text="Gerando QR..." Foreground="#44536A" TextAlignment="Center"
                               TextWrapping="Wrap" MaxWidth="185" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Grid>
                </Border>
                <Button x:Name="RefreshQrButton" Content="GERAR NOVO QR" Style="{StaticResource PrimaryButton}" Height="42" Margin="0,12,0,18" Click="RefreshQr_Click"/>

                <TextBlock Text="E-mail ou usuário da conta" Foreground="#CAD6E8"/>
                <TextBox x:Name="AccountBox" Margin="0,6,0,12"/>
                <TextBlock Text="Senha da conta" Foreground="#CAD6E8"/>
                <PasswordBox x:Name="AccountPasswordBox" Margin="0,6,0,8"/>
                <TextBlock Text="Login oficial do VMS. A senha não é salva." Foreground="#7890B2" FontSize="11"/>
                <Button x:Name="AccountLoginButton" Content="ENTRAR E CARREGAR CÂMERAS" Style="{StaticResource PrimaryButton}"
                        Height="44" Margin="0,12,0,0" IsEnabled="False" Click="AccountLogin_Click"/>

                <Grid Visibility="Collapsed">
                  <Image x:Name="CaptchaImage"/>
                  <TextBox x:Name="CaptchaBox"/>
                  <Button x:Name="RefreshCaptchaButton" Click="RefreshCaptcha_Click"/>
                </Grid>
              </StackPanel>
            </ScrollViewer>
          </Border>

          <Border Grid.Column="2" Background="{StaticResource Panel}" CornerRadius="10" Padding="20">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>
              <StackPanel>
                <TextBlock Text="Câmeras cadastradas" Foreground="White" FontSize="20" FontWeight="SemiBold"/>
                <TextBlock x:Name="CameraCountText" Text="Nenhuma câmera carregada" Foreground="{StaticResource Muted}" Margin="0,5,0,10"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                  <Button x:Name="RefreshOnlineDevicesButton" Content="↻  Atualizar nomes e câmeras da nuvem"
                          HorizontalAlignment="Left" Margin="0,0,10,0" Click="RefreshOnlineDevices_Click"/>
                  <Button Content="Compatibilidade" ToolTip="Ver identificação e recursos detectados"
                          HorizontalAlignment="Left" Margin="0,0,10,0" Click="ShowCompatibilityTable_Click"/>
                  <Button Content="Configurações da câmera" ToolTip="Ver recursos e configurações da câmera selecionada"
                          HorizontalAlignment="Left" Margin="0,0,10,0" Click="ShowSelectedDeviceSettings_Click"/>
                  <ComboBox x:Name="CameraGroupFilterBox" Width="190" SelectedIndex="0"
                            ToolTip="Filtrar por grupo ou ambiente" SelectionChanged="CameraGroupFilter_SelectionChanged">
                    <ComboBoxItem Content="Todos os grupos" Tag="*"/>
                  </ComboBox>
                </StackPanel>
              </StackPanel>
              <Grid Grid.Row="1">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="130"/></Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="Câmera" Foreground="#CAD6E8"/>
                  <ListBox x:Name="DeviceBox" Height="180" Margin="0,6,12,14" IsEnabled="False"
                           Background="#07111E" Foreground="#E8F0FA" BorderBrush="#334963"
                           SelectionChanged="DeviceBox_SelectionChanged">
                    <ListBox.ItemTemplate>
                      <DataTemplate>
                        <StackPanel Margin="6,5">
                          <TextBlock Text="{Binding Alias}" FontWeight="SemiBold"/>
                          <TextBlock Text="{Binding OrganizationSummary}" Foreground="#9CB3CC" FontSize="11"/>
                          <TextBlock Text="{Binding MaskedCloudId}" Foreground="#7890AA" FontSize="11"/>
                        </StackPanel>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </StackPanel>
                <StackPanel Grid.Column="1">
                  <TextBlock Text="Canal" Foreground="#CAD6E8"/>
                  <ComboBox x:Name="ChannelBox" SelectedIndex="0" Margin="0,6,0,14">
                    <ComboBoxItem Content="0"/><ComboBoxItem Content="1"/><ComboBoxItem Content="2"/><ComboBoxItem Content="3"/>
                  </ComboBox>
                </StackPanel>
              </Grid>
              <Border Grid.Row="2" Background="#0A1523" BorderBrush="#263A50" BorderThickness="1" CornerRadius="8" Padding="18">
                <StackPanel>
                  <TextBlock Text="Cadastro rápido" Foreground="White" FontSize="16" FontWeight="SemiBold"/>
                  <TextBlock x:Name="CameraSerialText" Text="Serial protegido: —" Foreground="{StaticResource Muted}" Margin="0,7,0,14"/>
                  <TextBlock x:Name="CameraTechnicalText" Text="Modelo e firmware: disponíveis após consulta"
                             Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,-8,0,14"/>
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <StackPanel>
                      <TextBlock Text="Nome exibido (apelido local)" Foreground="#CAD6E8"/>
                      <TextBox x:Name="CameraNameBox" Margin="0,6,0,12"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                      <TextBlock Text="Grupo / ambiente" Foreground="#CAD6E8"/>
                      <TextBox x:Name="CameraGroupBox" Margin="0,6,0,12"/>
                    </StackPanel>
                  </Grid>
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <StackPanel>
                      <TextBlock Text="Usuário do dispositivo" Foreground="#CAD6E8"/>
                      <TextBox x:Name="CameraUserBox" Margin="0,6,0,12"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                      <TextBlock Text="Nova senha (opcional)" Foreground="#CAD6E8"/>
                      <PasswordBox x:Name="CameraPasswordBox" Margin="0,6,0,12"/>
                    </StackPanel>
                  </Grid>
                  <CheckBox x:Name="ShowCameraInLiveBox" Content="Mostrar esta câmera no monitor"
                            Foreground="#CAD6E8" Margin="0,0,0,8"/>
                  <CheckBox x:Name="MirrorCameraDisplayBox" Content="Espelhar a exibição neste computador"
                            Foreground="#CAD6E8" Margin="0,0,0,14"/>
                  <TextBlock Text="Qualidade preferida desta câmera" Foreground="#CAD6E8"/>
                   <ComboBox x:Name="CameraQualityBox" SelectedIndex="0" Margin="0,6,0,14">
                     <ComboBoxItem Content="Usar padrão das configurações" Tag="Default"/>
                     <ComboBoxItem Content="SD (fluxo leve)" Tag="SD"/>
                     <ComboBoxItem Content="HD (fluxo principal)" Tag="HD"/>
                   </ComboBox>
                   <TextBlock Text="Quantidade de canais desta câmera" Foreground="#CAD6E8"/>
                   <Grid Margin="0,6,0,14">
                     <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                     <ComboBox x:Name="CameraChannelCountBox" SelectedIndex="0" Margin="0,0,8,0"
                               ToolTip="Use a quantidade confirmada no aplicativo oficial para impedir canais inexistentes na grade">
                       <ComboBoxItem Content="Detectar automaticamente" Tag="Auto"/>
                       <ComboBoxItem Content="1 canal" Tag="1"/>
                       <ComboBoxItem Content="2 canais" Tag="2"/>
                     </ComboBox>
                     <Button Grid.Column="1" Content="Revalidar" Click="RedetectSelectedCameraChannels_Click"
                             ToolTip="Descartar somente uma classificação inconclusiva e testar novamente na próxima abertura da grade"/>
                   </Grid>
                  <Expander Header="Recursos inteligentes desta câmera" Foreground="#CAD6E8"
                            Background="#0D1A29" BorderBrush="#29415D" BorderThickness="1"
                            Padding="10" Margin="0,0,0,14">
                    <StackPanel Margin="4,8,4,4">
                      <CheckBox x:Name="MotionTrackingBox" Content="Rastreamento de movimento" Foreground="#EAF1FA" Margin="0,3"/>
                      <TextBlock Text="Sensibilidade" Foreground="#8EA2BC" Margin="0,5,0,0"/>
                      <Slider x:Name="MotionSensitivitySlider" Minimum="1" Maximum="6" Value="3"
                              TickFrequency="1" IsSnapToTickEnabled="True"/>
                      <Grid Margin="0,5,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <StackPanel>
                          <TextBlock Text="Tempo de acompanhamento" Foreground="#8EA2BC"/>
                          <ComboBox x:Name="TrackingTimeBox" SelectedIndex="1" Margin="0,4,0,0">
                            <ComboBoxItem Content="5 segundos" Tag="5"/><ComboBoxItem Content="15 segundos" Tag="15"/><ComboBoxItem Content="30 segundos" Tag="30"/>
                          </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                          <TextBlock Text="Posição após rastrear" Foreground="#8EA2BC"/>
                          <ComboBox x:Name="TrackingPositionBox" SelectedIndex="0" Margin="0,4,0,0">
                            <ComboBoxItem Content="Manter posição atual" Tag="0"/>
                            <ComboBoxItem Content="Favorita 1" Tag="1"/><ComboBoxItem Content="Favorita 2" Tag="2"/>
                            <ComboBoxItem Content="Favorita 3" Tag="3"/><ComboBoxItem Content="Favorita 4" Tag="4"/>
                            <ComboBoxItem Content="Favorita 5" Tag="5"/><ComboBoxItem Content="Favorita 6" Tag="6"/>
                          </ComboBox>
                        </StackPanel>
                      </Grid>
                      <WrapPanel Margin="0,7,0,0">
                        <CheckBox x:Name="HumanDetectionBox" Content="Detecção de pessoa" Foreground="#EAF1FA" Margin="0,3,14,3"/>
                        <CheckBox x:Name="SmartAlertBox" Content="Alerta inteligente" Foreground="#EAF1FA" Margin="0,3,14,3"/>
                        <CheckBox x:Name="TraceBox" Content="Exibir rastros" Foreground="#EAF1FA" Margin="0,3,14,3"/>
                        <CheckBox x:Name="AudibleWarningBox" Content="Aviso sonoro" Foreground="#EAF1FA" Margin="0,3,14,3"/>
                        <CheckBox x:Name="LightWarningBox" Content="Aviso luminoso" Foreground="#EAF1FA" Margin="0,3"/>
                      </WrapPanel>
                      <TextBlock Text="Mensagem de disparo" Foreground="#8EA2BC" Margin="0,6,0,2"/>
                      <TextBox x:Name="TriggerMessageBox" Text="Movimento detectado" MaxLength="80"/>
                      <Button Content="Salvar preferências inteligentes" Margin="0,8,0,0" Click="ApplySmartControls_Click"/>
                      <TextBlock x:Name="SmartControlStatusText" Foreground="#8EA2BC" FontSize="11"
                                 TextWrapping="Wrap" Margin="0,6,0,0"
                                 Text="Os recursos disponíveis dependem do modelo da câmera."/>
                    </StackPanel>
                  </Expander>
                  <UniformGrid Columns="3">
                    <Button Content="↑ Subir" Click="MoveCameraUp_Click" Margin="3"/>
                    <Button Content="↓ Descer" Click="MoveCameraDown_Click" Margin="3"/>
                    <Button Content="Salvar" Style="{StaticResource PrimaryButton}" Click="SaveCameraProfile_Click" Margin="3"/>
                  </UniformGrid>
                  <UniformGrid Columns="2" Margin="3,8,3,0">
                    <Button Content="Testar conexão" Click="TestSelectedCamera_Click" Margin="0,0,4,0"/>
                    <Button Content="Remover localmente" Click="RemoveSelectedCamera_Click" Margin="4,0,0,0"/>
                  </UniformGrid>
                  <TextBlock x:Name="CameraSaveStatusText" Foreground="#42D67B" Margin="3,9,3,0" TextWrapping="Wrap"/>
                  <TextBlock Text="As preferências são locais. Senhas e tokens não são gravados neste cadastro."
                             Foreground="{StaticResource Muted}" TextWrapping="Wrap" FontSize="11" Margin="3,12,3,0"/>
                </StackPanel>
              </Border>
              <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button x:Name="ForgetAccountButton" Content="Sair da conta" IsEnabled="False" Click="ForgetAccount_Click" Margin="0,0,10,0"/>
                <Button x:Name="OpenCameraButton" Content="ABRIR SELECIONADA" Style="{StaticResource PrimaryButton}" IsEnabled="False" Click="OpenCamera_Click"/>
              </StackPanel>
            </Grid>
          </Border>
        </Grid>

        <Grid x:Name="RecordingsView" Visibility="Collapsed" Margin="22">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="430"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Background="{StaticResource Panel}" CornerRadius="10" Padding="18">
              <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <DockPanel>
                  <StackPanel>
                    <TextBlock Text="Biblioteca local" Foreground="White" FontSize="21" FontWeight="SemiBold"/>
                    <TextBlock Text="Imagens e vídeos salvos neste computador." Foreground="{StaticResource Muted}" Margin="0,4,0,0"/>
                  </StackPanel>
                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="↻" ToolTip="Atualizar" Click="RefreshCaptures_Click" Margin="0,0,6,0"/>
                    <Button Content="📁" ToolTip="Abrir pasta" Click="OpenCaptureFolder_Click"/>
                  </StackPanel>
                </DockPanel>
                <Grid Grid.Row="1" Margin="0,16,0,12">
                  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                  <UniformGrid Columns="2" Margin="0,0,0,10">
                    <Button x:Name="VideosFilterButton" Content="▶  Vídeos" Tag="Videos" Background="#1677FF"
                            Click="MediaFilter_Click" Margin="0,0,4,0"/>
                    <Button x:Name="ImagesFilterButton" Content="▧  Imagens" Tag="Images"
                            Click="MediaFilter_Click" Margin="4,0,0,0"/>
                  </UniformGrid>
                <ListBox x:Name="CaptureListBox" Grid.Row="1"
                         SelectionMode="Extended"
                         Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         MouseDoubleClick="CaptureListBox_MouseDoubleClick" SelectionChanged="CaptureListBox_SelectionChanged">
                  <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel ItemWidth="188"/></ItemsPanelTemplate></ListBox.ItemsPanel>
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <Border Width="178" Height="148" Margin="3" Background="#07111E" BorderBrush="#263A50" BorderThickness="1" CornerRadius="6">
                        <Grid>
                          <Grid.RowDefinitions><RowDefinition Height="96"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                          <Grid Background="#02070D">
                            <TextBlock Text="▶" Foreground="#45617F" FontSize="31" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Image Source="{Binding ThumbnailPath}" Stretch="UniformToFill"/>
                          </Grid>
                          <StackPanel Grid.Row="1" Margin="8,5,8,4">
                            <TextBlock Text="{Binding Title}" Foreground="White" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding Subtitle}" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,2,0,0"/>
                          </StackPanel>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
                </Grid>
                <DockPanel Grid.Row="2">
                  <TextBlock x:Name="CaptureListStatusText" Text="Nenhum arquivo encontrado."
                             Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="DeleteMediaButton" Content="🗑" ToolTip="Mover para a Lixeira"
                            IsEnabled="False" Click="DeleteSelectedMedia_Click" Margin="0,0,6,0"/>
                    <Button Content="Abrir" Click="OpenSelectedCapture_Click"/>
                  </StackPanel>
                </DockPanel>
              </Grid>
            </Border>
            <Border Grid.Column="2" Background="{StaticResource Panel}" CornerRadius="10" Padding="18">
              <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel>
                  <TextBlock x:Name="RecordingPlayerTitleText" Text="Selecione uma gravação" Foreground="White" FontSize="20" FontWeight="SemiBold"/>
                  <TextBlock x:Name="RecordingPlayerStatusText" Text="Clique duas vezes numa miniatura para reproduzir."
                             Foreground="{StaticResource Muted}" Margin="0,4,0,0"/>
                </StackPanel>
                <Border Grid.Row="1" Background="Black" Margin="0,14,0,12" BorderBrush="#263A50" BorderThickness="1">
                  <wfi:WindowsFormsHost x:Name="RecordingPlayerHost"/>
                </Border>
                <Grid Grid.Row="2">
                  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                  <Grid>
                    <Slider x:Name="RecordingTimeline" Minimum="0" Maximum="1" ValueChanged="RecordingTimeline_ValueChanged" Margin="0,0,115,0"/>
                    <TextBlock x:Name="RecordingPositionText" Text="00:00 / 00:00" Foreground="#CAD6E8"
                               HorizontalAlignment="Right" VerticalAlignment="Center"/>
                  </Grid>
                  <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                    <Button x:Name="RecordingPlayPauseButton" Content="▶ Reproduzir" Click="RecordingPlayPause_Click" Margin="0,0,8,0"/>
                    <Button x:Name="RecordingSoundButton" Content="🔇 Áudio" Click="RecordingSound_Click" Margin="0,0,8,0"/>
                    <Button Content="■ Parar" Click="RecordingStop_Click"/>
                  </StackPanel>
                </Grid>
              </Grid>
            </Border>
          </Grid>
        </Grid>

        <Grid x:Name="SettingsView" Visibility="Collapsed" Margin="22">
          <Grid.ColumnDefinitions><ColumnDefinition Width="380"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Border Background="{StaticResource Panel}" CornerRadius="10" Padding="22">
            <StackPanel>
              <TextBlock Text="Configurações" Foreground="White" FontSize="21" FontWeight="SemiBold"/>
              <CheckBox x:Name="RestoreLayoutBox" Content="Restaurar último layout" IsChecked="True"
                        Foreground="#CAD6E8" Margin="0,22,0,10" Click="PreferenceChanged_Click"/>
              <CheckBox x:Name="AutoReconnectBox" Content="Reconexão automática" IsChecked="False"
                        Foreground="#CAD6E8" Margin="0,0,0,10" Click="PreferenceChanged_Click"/>
              <CheckBox x:Name="StartWithWindowsBox" Content="Iniciar junto com o Windows"
                        Foreground="#CAD6E8" Margin="0,0,0,20" Click="StartWithWindowsChanged_Click"/>
              <TextBlock Text="Qualidade padrão" Foreground="#CAD6E8"/>
              <ComboBox x:Name="DefaultQualityBox" SelectedIndex="0" Margin="0,6,0,14"
                        SelectionChanged="PreferenceChanged_SelectionChanged"><ComboBoxItem Content="SD"/><ComboBoxItem Content="HD"/></ComboBox>
              <TextBlock Text="Tempo máximo para montar a grade" Foreground="#CAD6E8"/>
              <ComboBox x:Name="ConnectionTimeoutBox" SelectedIndex="1" Margin="0,6,0,14"
                        SelectionChanged="PreferenceChanged_SelectionChanged">
                <ComboBoxItem Content="30 segundos" Tag="30"/>
                <ComboBoxItem Content="60 segundos" Tag="60"/>
                <ComboBoxItem Content="90 segundos" Tag="90"/>
              </ComboBox>
              <TextBlock Text="Intervalo mínimo de reconexão" Foreground="#CAD6E8"/>
              <ComboBox x:Name="ReconnectDelayBox" SelectedIndex="0" Margin="0,6,0,14"
                        SelectionChanged="ReconnectDelayChanged_Click">
                <ComboBoxItem Content="1 minuto" Tag="60"/>
                <ComboBoxItem Content="2 minutos" Tag="120"/>
                <ComboBoxItem Content="5 minutos" Tag="300"/>
                <ComboBoxItem Content="15 minutos" Tag="900"/>
              </ComboBox>
              <TextBlock Text="Idioma" Foreground="#CAD6E8"/>
              <ComboBox x:Name="LanguageBox" SelectedIndex="0" Margin="0,6,0,14" SelectionChanged="LanguageChanged_Click">
                <ComboBoxItem Content="Português (Brasil)" Tag="pt-BR"/><ComboBoxItem Content="English" Tag="en"/>
              </ComboBox>
              <TextBlock Text="Tema" Foreground="#CAD6E8"/>
              <ComboBox x:Name="ThemeBox" SelectedIndex="0" Margin="0,6,0,14" SelectionChanged="ThemeChanged_Click">
                <ComboBoxItem Content="Escuro" Tag="Dark"/><ComboBoxItem Content="Claro" Tag="Light"/>
              </ComboBox>
              <TextBlock Text="Pasta de fotos" Foreground="#CAD6E8"/>
              <TextBox x:Name="CaptureFolderBox" Margin="0,6,0,6" IsReadOnly="True"/>
              <Button Content="Escolher pasta de fotos" Click="ChooseCaptureFolder_Click" Margin="0,0,0,14"/>
              <TextBlock Text="Pasta de gravações" Foreground="#CAD6E8"/>
              <TextBox x:Name="RecordingFolderBox" Margin="0,6,0,6" IsReadOnly="True"/>
              <Button Content="Escolher pasta de gravações" Click="ChooseRecordingFolder_Click" Margin="0,0,0,14"/>
              <TextBlock Text="Limite para gravações locais" Foreground="#CAD6E8"/>
              <ComboBox x:Name="StorageLimitBox" SelectedIndex="2" Margin="0,6,0,6"
                        SelectionChanged="StorageLimitChanged_Click">
                <ComboBoxItem Content="5 GB" Tag="5"/><ComboBoxItem Content="10 GB" Tag="10"/>
                <ComboBoxItem Content="20 GB" Tag="20"/><ComboBoxItem Content="50 GB" Tag="50"/>
                <ComboBoxItem Content="Sem limite" Tag="0"/>
              </ComboBox>
              <TextBlock Text="Ao atingir o limite, as gravações mais antigas são movidas para a Lixeira."
                         Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0"/>
            </StackPanel>
          </Border>
          <Border Grid.Column="2" Background="{StaticResource Panel}" CornerRadius="10" Padding="18">
            <Grid>
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
              <DockPanel>
                <StackPanel>
                  <TextBlock Text="Diagnóstico técnico" Foreground="White" FontSize="18" FontWeight="SemiBold"/>
                  <TextBlock Text="Nunca inclui senhas ou tokens." Foreground="{StaticResource Muted}" FontSize="11"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                  <Button Content="Copiar" Margin="0,0,8,0" Click="CopyLog_Click"/>
                  <Button Content="Exportar diagnóstico" Click="SendDiagnostic_Click"/>
                </StackPanel>
              </DockPanel>
              <TextBox x:Name="LogBox" Grid.Row="1" Margin="0,14,0,0" Background="#07111E" Foreground="#C9D7EB"
                       BorderBrush="#263A50" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas"/>
            </Grid>
          </Border>
        </Grid>
      </Grid>
    </Grid>
  </Grid>
</Window>
